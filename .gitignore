__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example

node_modules/
dist/
build/
.vite/

.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# === PUBLIC REPO — the rules below are load-bearing ===

# Operational runbooks: hostnames, ports, paths, infrastructure detail.
# The public contract lives in the design spec; the specifics stay local.
/docs/ops/

# Never commit real venue exports — they contain account numbers and positions.
# Anonymized fixtures belong in importers/*/fixtures/ and are committed deliberately.
/imports/
*.csv
!**/fixtures/**/*.csv

# Local database dumps
*.sql.gz
*.dump

# Agent/effort working notes: plans, execution ledgers, review and fix reports.
# `.superpowers/sdd/` ignores itself, but nothing covered the parent, so a
# `git add -A` would have committed the loose reports at `.superpowers/*.md`
# into a PUBLIC repo. Scratch by nature; the durable record belongs in
# docs/known-gaps.md and in commit messages.
/.superpowers/

.DS_Store
